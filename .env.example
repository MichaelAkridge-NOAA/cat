# =============================================================================
# CAT: Coral Annotation Tool - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# 
# For deployment:
#   1. Copy: cp .env.example .env
#   2. Edit .env with your actual passwords and settings
# =============================================================================

# -----------------------------------------------------------------------------
# Oracle Database Configuration
# -----------------------------------------------------------------------------
# Root database password (for SYSTEM user)
ORACLE_PASSWORD=ChangeMe123

# Application schema (database user for CAT - auto-created by Oracle container)
# Note: docker-compose.cat.yml maps these to what the CAT app reads:
#   APP_SCHEMA_NAME     -> CAT_DB_USER
#   APP_SCHEMA_PASSWORD -> CAT_DB_PASSWORD
# If running without compose, set CAT_DB_USER / CAT_DB_PASSWORD directly.
APP_SCHEMA_NAME=cat_user
APP_SCHEMA_PASSWORD=ChangeMe123

# Database service name (usually FREEPDB1 for Oracle Free container)
DB_SERVICE_NAME=FREEPDB1

# -----------------------------------------------------------------------------
# CAT Application Settings
# -----------------------------------------------------------------------------
# Storage backend: 'oracle' for database mode, 'file' for JSON-based storage
CAT_STORAGE_BACKEND=oracle

# Server settings
CAT_HOST=0.0.0.0
CAT_PORT=8000

# Host port mappings (left side of docker port mapping)
# Change these if Cloud Workstations cannot forward the default ports.
CAT_HOST_PORT=8000
ORACLE_HOST_PORT=1521

# Auto-bootstrap: create CAT tables and ingest reference data on startup
# Set to 'false' if you want to bootstrap manually
CAT_DB_AUTO_BOOTSTRAP=true

# -----------------------------------------------------------------------------
# GCS/GDAL Settings (for accessing Google Cloud Storage)
# -----------------------------------------------------------------------------
# These are set automatically in Dockerfile but can be overridden
# GS_NO_SIGN_REQUEST=YES
# GDAL_HTTP_MERGE_CONSECUTIVE_RANGES=YES
# GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR
# CPL_VSIL_CURL_ALLOWED_EXTENSIONS=.tif,.tiff

# -----------------------------------------------------------------------------
# Optional: Google Cloud Workstation Proxy Settings
# -----------------------------------------------------------------------------
# These are for outbound HTTP(S) traffic from containers/build steps.
# They DO NOT control inbound Cloud Workstation port forwarding.
# If your Cloud Workstation uses an enterprise proxy, uncomment and configure:
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,database-oracle-free,cat-app
